rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function active() { return request.auth != null && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isActive == true; }
    function admin() { return active() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function image() { return request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)'); }
    match /avatars/{uid}/{file} {
      allow read: if active() && (request.auth.uid == uid || admin());
      allow create, update: if active() && request.auth.uid == uid && image();
      allow delete: if active() && (request.auth.uid == uid || admin());
    }
    match /gym/{file=**} {
      allow read: if true;
      allow create, update: if admin() && image();
      allow delete: if admin();
    }
  }
}
